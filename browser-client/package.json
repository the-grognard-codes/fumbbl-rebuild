{
  "name": "ffb-browser-m1a",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "assets:sync": "node ../assets/game/scripts/sync-browser-assets.mjs",
    "assets:check": "node --test ../assets/game/scripts/png-art.test.mjs ../assets/game/scripts/stadium-geometry.test.mjs ../assets/game/scripts/stadium-jigsaw-catalog.test.mjs && node ../assets/game/scripts/sync-browser-assets.mjs --check",
    "predev": "npm run assets:sync",
    "prebuild": "npm run assets:sync",
    "prebuild:play": "npm run assets:sync",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:play": "tsc --noEmit && vite build --config vite.play.config.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:interaction": "node ../tools/validation/browser-suites.mjs --family interaction",
    "test:adjustments": "node test/match-adjustments-ui.mjs",
    "test:ui-comments": "node test/hud-comments-ui.mjs && node test/dugout-ui.mjs && node test/chat-ui.mjs && node test/chat-speaker-ui.mjs && node test/game-menu-events-ui.mjs",
    "test:reconnect-ui": "node test/reconnect-ui.mjs",
    "demo": "node test/browser-demo.mjs",
    "demo:choice": "node test/choice-demo.mjs",
    "demo:renderer-failures": "node test/renderer-failure-demo.mjs",
    "demo:renderer-lifecycle": "node test/renderer-lifecycle-demo.mjs",
    "demo:prepared-match": "node test/prepared-match-demo.mjs prepare"
  },
  "dependencies": {
    "pixi.js": "8.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
