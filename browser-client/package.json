{
  "name": "ffb-browser-m1a",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "proof:sprites:export": "node ../assets/game/scripts/build-sprite-proof.mjs && node ../assets/game/scripts/build-sprite-animation-proof.mjs",
    "proof:sprites:check": "node ../assets/game/scripts/build-sprite-proof.mjs --check && node ../assets/game/scripts/build-sprite-animation-proof.mjs --check && node --test test/sprite-proof.test.ts test/sprite-proof-animation.test.ts",
    "review:sprites": "node test/sprite-proof-ui.mjs",
    "mockups:legacy-prompts": "node prototypes/legacy-prompts/serve.mjs",
    "mockups:skill-prompts": "node prototypes/skill-prompts/serve.mjs",
    "mockups:limited-actions": "node prototypes/limited-actions/serve.mjs",
    "mockups:block-assists": "node prototypes/block-assists/serve.mjs",
    "mockups:dice-effects": "node prototypes/dice-effects/serve.mjs",
    "assets:sync": "node ../assets/game/scripts/sync-browser-assets.mjs",
    "assets:check": "node ../assets/game/scripts/build-team-colors.mjs --check && node ../assets/game/scripts/build-sprite-proof.mjs --check && node ../assets/game/scripts/build-sprite-animation-proof.mjs --check && node --test ../assets/game/scripts/png-art.test.mjs ../assets/game/scripts/stadium-geometry.test.mjs ../assets/game/scripts/stadium-jigsaw-catalog.test.mjs ../assets/game/scripts/sync-browser-assets.test.mjs && node ../assets/game/scripts/sync-browser-assets.mjs --check",
    "predev": "npm run assets:sync",
    "predev:stadium": "npm run assets:sync",
    "prebuild": "npm run assets:sync",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:stadium": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "prereview:stadium": "npm run assets:sync",
    "review:stadium": "node --experimental-strip-types test/stadium-hybrid-review.mjs",
    "prereview:stadium-walls": "npm run assets:sync",
    "review:stadium-walls": "node --experimental-strip-types test/stadium-wall-review.mjs",
    "build": "tsc --noEmit && vite build",
    "build:play": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:interaction": "node ../tools/validation/browser-suites.mjs --family interaction",
    "test:adjustments": "node test/match-adjustments-ui.mjs",
    "test:ui-comments": "node test/hud-comments-ui.mjs && node test/dugout-ui.mjs && node test/chat-ui.mjs && node test/chat-speaker-ui.mjs && node test/game-menu-events-ui.mjs",
    "test:reconnect-ui": "node test/reconnect-ui.mjs",
    "test:renderer": "node test/renderer-diagnostics-ui.mjs"
  },
  "dependencies": {
    "pixi.js": "8.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
