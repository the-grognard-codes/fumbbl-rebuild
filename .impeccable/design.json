  "narrative": {
    "northStar": "The Pixel Pitch",
    "overview": "MUTP uses crisp pixel artwork, dark framed surfaces, and clear controls around\nfantasy-football. Its original mole-under-gridiron mark, established palette,\nand readable player silhouettes carry the identity. The character is welcoming\nand lightly tabletop-fantasy inspired. Keep the description understated.\n\nButtons, panels, and inputs are **tactile and legible**. Public pages allow more\nspace around content; the match HUD uses compact controls and translucent\nsupporting panels to keep the pitch visible. These are related treatments,\nnot a requirement to make every screen use identical typography or density.",
    "keyCharacteristics": [
      "Crisp pixel artwork and approved outlined logo lettering.",
      "Dark surfaces with visible frames, warm actions, and cool information accents.",
      "Structural framed layers: offset shadows on public pages, inset framing in play.",
      "Distinct typography roles for site reading, pixel controls, and the match HUD."
    ],
    "rules": [
      {
        "name": "The Palette Scope Rule",
        "body": "The eight-color logo palette is fixed by\n[brand package v4](site/src/assets/brand-package-v4/README.md). UI variants may use\nthe other extracted interface colors. Team-kit choices use the separate\n[team-color system](docs/specs/team-colors.md); neither interface nor team art\nauthorizes recoloring the logo. Sidecar tonal ramps are generated preview aids,\nnot additional approved production colors.",
        "section": "colors"
      },
      {
        "name": "The Lettering Rule",
        "body": "Use HTML text for editable names, controls, and game\nstate. Keep the approved logo wordmark as artwork; do not recreate it by typing\nthe name in one of the interface fonts. Earlier Alegreya/Barlow preview guidance\nin the [font inventory](assets/game/ui/fonts/README.md) is not a global font policy.",
        "section": "typography"
      },
      {
        "name": "The Readable Layer Rule",
        "body": "Support-panel opacity affects the backing, not the\ntext, player art, or controls. Preserve foreground legibility while the pitch\nremains visible. Exact shadows and motion values are recorded in the sidecar.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Preserve the approved mole-under-gridiron identity, logo artwork, and typography roles.",
      "Use the public-site and HUD variants in their existing contexts.",
      "Keep match controls legible over the pitch and preserve canonical interaction behavior.",
      "Use live text for labels, game state, and accessible explanations.",
      "Follow canonical asset, team-color, and sprite documentation for their respective scopes.",
      "Preserve observed focus, disabled, reduced-motion, and responsive behavior."
    ],
    "donts": [
      "Recolor, stretch, apply effects to, or retype the approved logo.",
      "Treat historical concepts, old font previews, or asset wishlists as current implementation.",
      "Force the logo palette onto every team kit or replace approved pixel art with a new style.",
      "Make the entire product use one font, radius, density, or shadow treatment.",
      "Reuse outdated homepage positioning instead of the confirmed product purpose.",
      "Claim accessibility conformance or physical-device coverage from these extracted styles."
    ]
  }
}
