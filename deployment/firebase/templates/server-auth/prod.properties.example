# Reference identity mapping. The service reads environment variables documented
# in deployment/game-service/README.md, not this properties file.
firebase.auth.project-id=molesunderthepitch-dotorg
firebase.auth.issuer=https://securetoken.google.com/molesunderthepitch-dotorg
firebase.auth.audience=molesunderthepitch-dotorg
firebase.auth.authorized-domain=molesunderthepitch.org
